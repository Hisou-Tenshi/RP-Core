{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "snapshot": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "character": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "instructions": {
                  "type": "string",
                  "maxLength": 131072
                }
              },
              "required": [
                "id",
                "name",
                "instructions"
              ]
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "user",
                      "assistant"
                    ]
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 131072
                  }
                },
                "required": [
                  "role",
                  "content"
                ]
              },
              "maxItems": 1000
            },
            "memories": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 131072
              },
              "maxItems": 128
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 131072
              },
              "maxItems": 128
            },
            "relationship": {
              "type": "string",
              "maxLength": 131072
            },
            "summary": {
              "type": "string",
              "maxLength": 131072
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 131072
                  },
                  "mode": {
                    "enum": [
                      "read",
                      "deferred"
                    ]
                  },
                  "input_schema": {
                    "type": [
                      "object",
                      "boolean"
                    ]
                  }
                },
                "required": [
                  "name",
                  "description",
                  "mode",
                  "input_schema"
                ]
              },
              "maxItems": 64
            },
            "policy": {
              "type": "object",
              "properties": {
                "two_stage": {
                  "type": "boolean"
                },
                "allow_silence": {
                  "type": "boolean"
                },
                "max_tool_rounds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                },
                "history_limit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "max_messages": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "max_message_chars": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20000
                }
              },
              "required": []
            },
            "extensions": {
              "type": "object"
            }
          },
          "required": [
            "revision",
            "character"
          ]
        }
      },
      "required": [
        "snapshot"
      ]
    },
    {
      "type": "object",
      "properties": {
        "receipt": {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "status": {
              "enum": [
                "replied",
                "silent",
                "maintained"
              ]
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "kind": {
                    "const": "message"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 131072
                  },
                  "reply_to": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "text"
                ]
              },
              "maxItems": 20
            },
            "effects_queued": {
              "type": "integer",
              "minimum": 0
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "event_id",
            "session_id",
            "status",
            "actions",
            "effects_queued",
            "revision"
          ]
        }
      },
      "required": [
        "receipt"
      ]
    }
  ]
}
