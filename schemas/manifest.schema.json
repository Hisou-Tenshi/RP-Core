{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "rp/1"
    },
    "adapter": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 600
        }
      },
      "required": [
        "command"
      ]
    },
    "max_events": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "protocol",
    "adapter"
  ]
}
