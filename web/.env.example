# Public project metadata. Configure these for your own fork.
RP_PUBLIC_REPOSITORY=Hisou-Tenshi/RP-Core
RP_PUBLIC_BRANCH=main
RP_APP_ORIGIN=https://rp-core-console.vercel.app
# Numeric GitHub user IDs, comma separated. Empty = deny all writes.
RP_ADMIN_IDS=
# GitHub OAuth App callback: <RP_APP_ORIGIN>/api/auth/callback/github
# The console requests the scopes read:user user:email public_repo — user:email is
# required, otherwise accounts with a private email fail login with error=Configuration.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate a random 32-byte secret. Never commit real credentials.
AUTH_SECRET=
